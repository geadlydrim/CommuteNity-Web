NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Nominatim geocoding proxy — required by Nominatim's usage policy (identifiable UA + contact)
GEOCODER_USER_AGENT=CommuteNity/0.1 (https://commutenity.app; contact@commutenity.app)

# Database connection for `npm test` (database tests run as a rider inside rolled-back
# transactions). Use the session pooler string from Supabase → Connect. Tests skip if unset.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
